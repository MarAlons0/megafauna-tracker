ANTHROPIC_API_KEY=your_key_here
# iNaturalist API requires no key for reads
# ADF&G data is scraped (no key needed)

# Bearer token TripPlanner sends to POST /api/wildlife-report (provider contract).
# Issue a random secret; also set it as MEGAFAUNA_API_TOKEN in the TripPlanner config.
# The endpoint returns 503 until this is set.
MEGAFAUNA_API_TOKEN=your_random_shared_secret_here
